{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "types": ["node"],
    "outDir": "dist",
    "paths": {
      "@app/db": ["packages/db/src/index.ts"],
      "@app/schema": ["packages/schema/src/index.ts"],
      "@app/storage": ["packages/storage/src/index.ts"],
      "@app/api": ["apps/api/src/index.ts"],
      "@app/worker": ["apps/worker/src/index.ts"],
      "@app/mcp": ["apps/mcp/src/index.ts"]
    }
  }
}